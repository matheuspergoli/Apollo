{
	"name": "apollo-dashboard",
	"private": true,
	"license": "GPL-3.0-only",
	"version": "1.0.3",
	"packageManager": "pnpm@12.15.0",
	"engines": {
		"node": ">=24 <25"
	},
	"type": "module",
	"scripts": {
		"dev": "vite --host 127.0.0.1",
		"build": "pnpm run typecheck && vite build && node scripts/emit-host-pages.mjs",
		"build:host": "pnpm run build && node scripts/emit-host-pages.mjs --host",
		"routes:generate": "node scripts/generate-routes.mjs",
		"typecheck": "pnpm run routes:generate && tsc --noEmit",
		"test": "vitest run && pnpm run test:tooling",
		"test:tooling": "node --test scripts/tests/notices.mjs",
		"check:dev": "node scripts/check-dev.mjs",
		"test:browser": "pnpm run build && playwright test",
		"verify": "pnpm run check && pnpm run typecheck && pnpm test && pnpm run check:dev && pnpm run test:browser",
		"check": "biome check .",
		"format": "biome format --write ."
	},
	"dependencies": {
		"@base-ui/react": "1.9.0",
		"@fontsource-variable/geist": "5.3.0",
		"@fontsource-variable/geist-mono": "5.3.0",
		"@tabler/icons-react": "3.49.0",
		"@tanstack/react-query": "5.104.5",
		"@tanstack/react-router": "1.170.45",
		"class-variance-authority": "0.7.1",
		"cn": "0.5.0",
		"fflate": "0.8.3",
		"qrcode": "1.5.4",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"tw-animate-css": "1.4.0",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@playwright/test": "1.64.1",
		"@tailwindcss/vite": "4.3.3",
		"@tanstack/router-generator": "1.167.45",
		"@tanstack/router-plugin": "1.168.47",
		"@types/qrcode": "1.5.6",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.2",
		"tailwindcss": "4.3.3",
		"typescript": "7.0.2",
		"vite": "8.3.4",
		"vitest": "5.0.5"
	}
}
